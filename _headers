# Always check for a fresh copy of the app itself.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Voice files and images change rarely — keep them cached a week.
/voice/*
  Cache-Control: public, max-age=604800
/loren.jpg
  Cache-Control: public, max-age=604800
